{
  "name": "voz-meeting",
  "version": "0.1.1",
  "description": "Record and transcribe meetings on your Mac with one hotkey: your microphone plus system audio, transcribed locally by Voz",
  "type": "module",
  "keywords": ["voz-package", "meeting", "transcription"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucakammerer/voz-extensions.git",
    "directory": "voz-meeting"
  },
  "os": ["darwin"],
  "cpu": ["arm64"],
  "voz": { "apiVersion": 1 },
  "files": ["index.ts", "detection.ts", "detection-config.json", "native-check.ts", "meeting-rec", "meeting-rec.swift"],
  "scripts": {
    "build": "swiftc -O -swift-version 5 meeting-rec.swift -o meeting-rec",
    "prepack": "bun run build",
    "test": "bun test",
    "check:native": "bun run native-check.ts"
  },
  "devDependencies": { "@types/bun": "latest" }
}
